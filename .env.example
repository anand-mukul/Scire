# ────────────────────────────────────────────
# Scire Frontend — Environment Variables
# Copy this to .env.local and fill in your values
# ────────────────────────────────────────────

# ─── API URLs (REQUIRED) ───
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/session

# ─── Payments ───
NEXT_PUBLIC_RAZORPAY_KEY_ID=       # Public key from Razorpay Dashboard

# ─── Branding ───
NEXT_PUBLIC_SUPPORT_EMAIL=support@scire.in
NEXT_PUBLIC_NOREPLY_EMAIL=noreply@mail.scire.in

# ─── Development Only (NEVER set in production builds) ───
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true
# NEXT_PUBLIC_DEV_AUTH_ROLE=PLATFORM_ADMIN

# ─── Optional: Analytics/Monitoring ───
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA_ID=
