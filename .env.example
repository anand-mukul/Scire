# Scire Frontend Environment Variables
# Copy this file to .env.local for local development

# Backend API URL (required)
# Development: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# WebSocket URL for real-time features (required)=
# Development: ws://localhost:8000/api/v1/ws/session
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/session

# Optional: Analytics/monitoring (add if needed)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA_ID=
